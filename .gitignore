# ВНИМАНИЕ: этот репозиторий ПУБЛИЧНЫЙ — всё, что сюда попадёт,
# видно всему интернету. Ниже перечислено то, что выкладывать нельзя.

# Файл с настоящими паролями и ключами — НИКОГДА не выкладываем на GitHub
.env
.env.local

# Настоящий файл настроек с ТОКЕНОМ БОТА (образец config.example.ini — можно)
config.ini
*/config.ini
mail2tdm.log
mail2tdm_seen.json
*/mail2tdm_seen.json

# Документация TDM — внутренний документ, не для публичного репозитория
*.pdf

# Отчёты сканеров: внутри пути, адреса серверов и устройство TDM.
# Это служебная информация — она не должна попасть в открытый доступ.
TDM_scan_report.txt
TDM_asar_report.txt
*_report*.txt
*scan_report*.txt
*scan-report*.txt
reports/

# Рабочая переписка и письма — там служебные данные и персональные данные людей
*.msg
*.eml
*.pst
*.ost
mail/
письма/
примеры-писем/

# Служебные файлы macOS
.DS_Store

# Логи (записи о работе программы)
*.log

# Папки с установленными библиотеками — их не хранят в репозитории
node_modules/
venv/
.venv/
__pycache__/
